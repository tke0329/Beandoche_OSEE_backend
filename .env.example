# Copy this file to .env and replace local secrets before running the backend.
DB_URL=jdbc:postgresql://localhost:5432/osee
DB_USERNAME=osee
DB_PASSWORD=osee-local-password

# Generate a Base64-encoded secret of at least 32 bytes. Do not reuse this placeholder.
AUTH_JWT_SECRET=replace-with-base64-encoded-32-byte-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_SESSION_TTL=48h
# Local HTTP: false. Set true for HTTPS deployments (including reverse proxies).
AUTH_COOKIE_SECURE=false

# Paste the Web application client ID issued by Google Cloud Console.
# Google client secret is not used because the backend verifies a Google ID Token.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Exact frontend origins, separated by commas. Do not use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Kakao Authorization Code login. Keep real keys local; Admin keys are not required.
# Enable Kakao Login and register the exact Redirect URI in Kakao Developers.
KAKAO_OAUTH_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_OAUTH_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/social/kakao/callback
OSEE_FRONTEND_ORIGIN=http://localhost:5173
