# Copy this file to .env and replace local secrets before running the backend.
DB_URL=jdbc:postgresql://localhost:5432/osee
DB_USERNAME=osee
DB_PASSWORD=osee-local-password

# Generate a Base64-encoded secret of at least 32 bytes. Do not reuse this placeholder.
AUTH_JWT_SECRET=replace-with-base64-encoded-32-byte-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_SESSION_TTL=48h

# Google server/web OAuth client ID used to validate the ID Token audience.
# This flow does not require a Google client secret in the backend.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_ISSUER=https://accounts.google.com
GOOGLE_OAUTH_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_OAUTH_CONNECT_TIMEOUT=3s
GOOGLE_OAUTH_READ_TIMEOUT=3s

# Reserved for the upcoming Kakao Authorization Code/OIDC login implementation.
# Kakao Admin keys are intentionally excluded because login does not require them.
KAKAO_OAUTH_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_OAUTH_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/social/kakao/callback
KAKAO_OAUTH_ISSUER=https://kauth.kakao.com
KAKAO_OAUTH_JWK_SET_URI=https://kauth.kakao.com/.well-known/jwks.json
KAKAO_OAUTH_CONNECT_TIMEOUT=3s
KAKAO_OAUTH_READ_TIMEOUT=3s
